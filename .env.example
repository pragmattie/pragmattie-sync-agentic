# Copy to .env and fill in local-only values. Never commit .env.

# Database (MySQL 8.4). Containers reach the db service at db:3306; the host reaches it at
# MYSQL_HOST_PORT.
MYSQL_DATABASE=pragmattie_sync
MYSQL_USER=pragmattie_sync
MYSQL_PASSWORD=pragmattie_sync
MYSQL_ROOT_PASSWORD=pragmattie_sync
MYSQL_HOST_PORT=3307

# Host ports the stack publishes. Containers keep their own ports; only the host side changes,
# and the web apps' API addresses follow these.
CRM_WEB_PORT=5173
INSIGHTS_WEB_PORT=5174
API_PORT=8000
ORCH_PORT=8001

# The proxy's host port for http://pragmattie-sync.localhost (the CRM) and
# http://insights.pragmattie-sync.localhost (Delivery Insights). Add :PROXY_PORT to both
# addresses when it isn't 80.
PROXY_PORT=80

# Before cutover (beside v1): use these instead, so both stacks fit on one machine (see the
# README). After cutover v1's stack is down, so they can stay or go back to the defaults.
# CRM_WEB_PORT=15173
# INSIGHTS_WEB_PORT=15174
# API_PORT=18000
# ORCH_PORT=18001
# MYSQL_HOST_PORT=13307
# PROXY_PORT=18080
# GITHUB_REPO=pragmattie/pragmattie-sync-agentic

# Orchestrator's calls to Claude
ANTHROPIC_API_KEY=

# Orchestrator's calls to GitHub (issues, pull requests, the delivery board). Before cutover,
# GITHUB_TOKEN is v2's own read-only token. After cutover (docs/cutover.md) it is v2's write token:
# fine-grained, resource owner pragmattie, pragmattie-sync-agentic only, expiring in 90 days, with
# Metadata read; Contents read; Issues, Pull requests, Commit statuses and Deployments read and
# write; Actions read. Never commit it.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_API_URL=
BOARD_OWNER=pragmattie
BOARD_NUMBER=1

# The read-only collector (`docker compose --profile collect up -d`): seconds between runs.
# Beside v1, GITHUB_TOKEN above is v2's own read-only token, never v1's.
COLLECT_SECONDS=900

# Orchestrator's poll loop (`docker compose --profile agents up -d`): off does nothing, observe
# decides and records but writes nothing to GitHub, shadow writes but never blocks, enforce makes
# the gate real. Anything else is refused at start. Before cutover (beside v1), use
# ORCHESTRATOR_MODE=observe with `--profile agents`: the read-only GITHUB_TOKEN is enough. After
# cutover, use ORCHESTRATOR_MODE=enforce with `--profile agents` and the write token.
ORCHESTRATOR_MODE=off
POLL_SECONDS=30

# The planner drafts options for a slipping milestone with paid Claude calls (at most 4 per
# milestone a day). Its own switch: off spends nothing. On, it runs in the collector after the
# forecaster, and in the poll loop when ORCHESTRATOR_MODE isn't off.
PLANNER_MODE=off
